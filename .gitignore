# Python
__pycache__/
*.py[cod]
*$py.class

# Test/cache
.pytest_cache/
.coverage
htmlcov/

# Build output
build/
dist/
*.spec.bak
*.spec

# Portable build product (generated by portable/BUILD_ON_MY_PC.bat).
# Same class of artefact as build/ and dist/: it bundles a ~24MB copy of the
# embeddable CPython runtime plus the vendored KaTeX/QR/font assets, and it is
# regenerated by running the build script on the target PC. Ignoring it keeps a
# whole interpreter from ever being committed, and keeps `git status` honest.
# The folder on disk is untouched by this rule; distribute it on the USB stick.
calculator_portable/

# Virtual environments
.venv/
venv/
env/

# IDE/editor
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs/temp
*.log
*.tmp
*.bak

.codex_test_tmp/
graphify-out/
*.pyc
